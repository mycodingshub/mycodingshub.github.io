[{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/guides/go-concurrency-complete-guide/01-go-concurrency-goroutines/","section":"Guides 리스트","summary":"\u003cp\u003eGo 언어를 배우면서 가장 흥미롭고 강력하다고 느끼는 부분이 바로 **동시성(Concurrency)**인데요.\u003c/p\u003e\n\u003cp\u003e어떤 문장을 단어 단위로 끊어서 출력하는 간단한 함수를 예로 들어 이야기를 시작해 보겠습니다.\u003c/p\u003e","title":"Go Concurrency 마스터하기: 고루틴, 생각보다 쉽습니다","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/01-server-components-data-fetching-best-practice/","section":"Guides 리스트","summary":"\u003cp\u003e결론부터 말씀드리면, 데이터 페칭은 이제 \u0026lsquo;서버 컴포넌트(Server Components)\u0026lsquo;에서 처리하는 것이 좋은데요.\u003c/p\u003e\n\u003cp\u003e클라이언트 컴포넌트(Client Components)에서 데이터를 가져오는 방식은 더 이상 권장되지 않는 베스트 프랙티스입니다.\u003c/p\u003e","title":"Next.js 서버 컴포넌트 데이터 fetching 이제 선택이 아닌 필수인 이유","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/nextjs-15-react-19-best-practices-guide/01-basic-rules-and-directory-structure/","section":"Guides 리스트","summary":"\u003ch3 class=\"relative group\"\u003e들어가며\n    \u003cdiv id=\"들어가며\" class=\"anchor\"\u003e\u003c/div\u003e\n    \n    \u003cspan\n        class=\"absolute top-0 w-6 transition-opacity opacity-0 -start-6 not-prose group-hover:opacity-100 select-none\"\u003e\n        \u003ca class=\"text-primary-300 dark:text-neutral-700 !no-underline\" href=\"#%eb%93%a4%ec%96%b4%ea%b0%80%eb%a9%b0\" aria-label=\"Anchor\"\u003e#\u003c/a\u003e\n    \u003c/span\u003e\n    \n\u003c/h3\u003e\n\u003cp\u003e\u003ccode\u003eNext.js 15\u003c/code\u003e와 \u003ccode\u003eReact 19\u003c/code\u003e로 웹 앱을 만들 때, \u003ccode\u003eApp Router\u003c/code\u003e의 철학에 맞는 프로젝트 구조와 개발 규칙을 세우는 게 정말 중요한데요.\u003c/p\u003e","title":"Next.js 15와 React 19 기본 규칙 및 디렉토리 구성","type":"guides"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/guides/go-concurrency-complete-guide/02-go-concurrency-channels/","section":"Guides 리스트","summary":"\u003cp\u003e지난 시간에는 고루틴을 실행하고 채널을 통해 기본적인 데이터를 주고받는 법을 배웠는데요.\u003c/p\u003e\n\u003cp\u003e사실 채널에는 우리가 미처 다루지 못한 흥미로운 기능들이 훨씬 더 많이 숨어 있습니다.\u003c/p\u003e","title":"Go Concurrency 마스터하기: 채널(Channel)의 모든 것","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/02-nextjs-component-level-data-fetching/","section":"Guides 리스트","summary":"\u003cp\u003e결론부터 말하자면, 데이터 페칭은 그 데이터를 직접 사용하는 컴포넌트 바로 안쪽에 배치하는 \u0026lsquo;코로케이션(colocation)\u0026rsquo; 전략을 사용하는 게 좋은데요.\u003c/p\u003e\n\u003cp\u003e이렇게 하면 컴포넌트의 독립성을 극적으로 높일 수 있는 아주 중요한 원칙입니다.\u003c/p\u003e","title":"Next.js 데이터 fetching 컴포넌트 안으로 옮기면 생기는 놀라운 변화","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/nextjs-15-react-19-best-practices-guide/02-component-design/","section":"Guides 리스트","summary":"\u003ch3 class=\"relative group\"\u003e들어가며\n    \u003cdiv id=\"들어가며\" class=\"anchor\"\u003e\u003c/div\u003e\n    \n    \u003cspan\n        class=\"absolute top-0 w-6 transition-opacity opacity-0 -start-6 not-prose group-hover:opacity-100 select-none\"\u003e\n        \u003ca class=\"text-primary-300 dark:text-neutral-700 !no-underline\" href=\"#%eb%93%a4%ec%96%b4%ea%b0%80%eb%a9%b0\" aria-label=\"Anchor\"\u003e#\u003c/a\u003e\n    \u003c/span\u003e\n    \n\u003c/h3\u003e\n\u003cp\u003e\u003ccode\u003eNext.js 15\u003c/code\u003e와 \u003ccode\u003eReact 19\u003c/code\u003e에서 컴포넌트를 설계할 때는 서버 컴포넌트(Server Component)와 클라이언트 컴포넌트(Client Component)를 제대로 나누어 쓰고, 적절한 크기로 분리하며, 각자의 역할을 명확히 하는 게 정말 중요한데요.\u003c/p\u003e","title":"Next.js 15와 React 19 컴포넌트 설계, 유지보수 끝판왕 되는 법","type":"guides"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/guides/go-concurrency-complete-guide/03-go-concurrency-pipelines/","section":"Guides 리스트","summary":"\u003cp\u003e지금까지 우리는 고루틴과 채널이라는 강력한 재료들을 손질하는 법을 배웠습니다.\u003c/p\u003e\n\u003cp\u003e이제 이 재료들을 조립해서 \u003cstrong\u003e동시성 파이프라인\u003c/strong\u003e(Concurrent Pipeline)이라는 근사한 요리를 만들어볼 차례입니다.\u003c/p\u003e","title":"Go Concurrency 마스터하기: 파이프라인(Pipeline) 패턴과 에러 처리","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/03-nextjs-request-memoization-guide/","section":"Guides 리스트","summary":"\u003cp\u003e결론부터 말씀드리면, 데이터 페칭 로직을 별도의 레이어로 분리해서, \u0026lsquo;리퀘스트 메모이제이션\u0026rsquo;의 효과를 제대로 누릴 수 있는 설계를 하는 게 좋은데요.\u003c/p\u003e\n\u003cp\u003e이게 바로 이번 챕터의 핵심입니다.\u003c/p\u003e","title":"Next.js 중복 API 요청 Request Memoization으로 완벽하게 막는 법","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/nextjs-15-react-19-best-practices-guide/03-data-fetching/","section":"Guides 리스트","summary":"\u003ch3 class=\"relative group\"\u003e들어가며\n    \u003cdiv id=\"들어가며\" class=\"anchor\"\u003e\u003c/div\u003e\n    \n    \u003cspan\n        class=\"absolute top-0 w-6 transition-opacity opacity-0 -start-6 not-prose group-hover:opacity-100 select-none\"\u003e\n        \u003ca class=\"text-primary-300 dark:text-neutral-700 !no-underline\" href=\"#%eb%93%a4%ec%96%b4%ea%b0%80%eb%a9%b0\" aria-label=\"Anchor\"\u003e#\u003c/a\u003e\n    \u003c/span\u003e\n    \n\u003c/h3\u003e\n\u003cp\u003e\u003ccode\u003eNext.js 15\u003c/code\u003e와 \u003ccode\u003eReact 19\u003c/code\u003e 환경에서 데이터를 가져오는 방법은 서버 컴포넌트, 클라이언트 컴포넌트, 캐시 전략, 스트리밍 등 선택지가 정말 다양한데요.\u003c/p\u003e","title":"Next.js 15와 React 19 데이터 로딩, 완벽 정복 가이드","type":"guides"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/guides/go-concurrency-complete-guide/04-go-concurrency-time/","section":"Guides 리스트","summary":"\u003cp\u003e이번 장에서는 동시성 프로그램에서 \u003cstrong\u003e시간\u003c/strong\u003e(Time)을 다루는 다양한 기법들을 살펴봅니다.\u003c/p\u003e\n\u003cp\u003e단순히 \u003ccode\u003etime.Sleep\u003c/code\u003e을 쓰는 것 말고도 훨씬 우아하고 강력한 도구들이 많거든요.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e스로틀링\u003c/strong\u003e(Throttling)부터 \u003cstrong\u003e백프레셔\u003c/strong\u003e(Backpressure), \u003cstrong\u003e타임아웃\u003c/strong\u003e, 그리고 \u003cstrong\u003e타이머와 티커\u003c/strong\u003e까지 낱낱이 파헤쳐 봅시다.\u003c/p\u003e","title":"Go Concurrency 마스터하기: 시간(Time) 다루기, 더 이상 Sleep은 그만","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/04-nextjs-parallel-data-fetching-performance/","section":"Guides 리스트","summary":"\u003cp\u003e결론부터 말씀드리면, 데이터 페칭을 최대한 \u0026lsquo;병렬\u0026rsquo;로 처리되도록 설계해야 하는데요.\u003c/p\u003e\n\u003cp\u003e이를 위해 상황에 맞게 아래 세 가지 패턴을 자유자재로 사용할 줄 알아야 합니다.\u003c/p\u003e","title":"Next.js 데이터 fetching 병렬 처리로 성능 극대화하는 3가지 방법","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/nextjs-15-react-19-best-practices-guide/04-data-updating/","section":"Guides 리스트","summary":"\u003ch3 class=\"relative group\"\u003e들어가며\n    \u003cdiv id=\"들어가며\" class=\"anchor\"\u003e\u003c/div\u003e\n    \n    \u003cspan\n        class=\"absolute top-0 w-6 transition-opacity opacity-0 -start-6 not-prose group-hover:opacity-100 select-none\"\u003e\n        \u003ca class=\"text-primary-300 dark:text-neutral-700 !no-underline\" href=\"#%eb%93%a4%ec%96%b4%ea%b0%80%eb%a9%b0\" aria-label=\"Anchor\"\u003e#\u003c/a\u003e\n    \u003c/span\u003e\n    \n\u003c/h3\u003e\n\u003cp\u003e\u003ccode\u003eNext.js 15\u003c/code\u003e와 \u003ccode\u003eReact 19\u003c/code\u003e 환경에서 데이터를 업데이트하는 방법은 서버 액션(Server Actions), \u003ccode\u003euseOptimistic\u003c/code\u003e, \u003ccode\u003eTanStack Query\u003c/code\u003e 등 정말 다양한데요.\u003c/p\u003e","title":"Next.js 15 데이터 업데이트 완전 정복, Server Actions부터 낙관적 업데이트까지","type":"guides"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/guides/go-concurrency-complete-guide/05-go-concurrency-context/","section":"Guides 리스트","summary":"\u003cp\u003e프로그래밍에서 \u003cstrong\u003e컨텍스트\u003c/strong\u003e(Context)는 어떤 작업이 실행되는 환경 정보를 의미합니다.\u003c/p\u003e\n\u003cp\u003eGo에서 \u003ccode\u003econtext\u003c/code\u003e라고 하면 보통 표준 패키지인 \u003ccode\u003econtext.Context\u003c/code\u003e 인터페이스를 말하는데요.\u003c/p\u003e\n\u003cp\u003e원래는 HTTP 요청 처리를 쉽게 하려고 만들어졌지만, 지금은 모든 동시성 코드에서 \u003cstrong\u003e작업 취소\u003c/strong\u003e와 \u003cstrong\u003e타임아웃 관리\u003c/strong\u003e의 표준으로 자리 잡았습니다.\u003c/p\u003e","title":"Go Concurrency 마스터하기: 컨텍스트(Context), 취소와 타임아웃의 마법사","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/05-nextjs-n-plus-one-problem-with-dataloader/","section":"Guides 리스트","summary":"\u003cp\u003e결론부터 말씀드리면, 컴포넌트의 독립성을 높이다 보면 필연적으로 \u0026lsquo;N+1 데이터 페칭\u0026rsquo; 문제가 생기기 쉬운데요.\u003c/p\u003e\n\u003cp\u003e이 문제는 \u0026lsquo;데이터로더(DataLoader)\u0026lsquo;의 배치 처리 기능을 이용해 해결하는 것이 정답입니다.\u003c/p\u003e","title":"Next.js N+1 문제 DataLoader로 해결하는 가장 확실한 방법","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/nextjs-15-react-19-best-practices-guide/05-state-management/","section":"Guides 리스트","summary":"\u003ch3 class=\"relative group\"\u003e들어가며\n    \u003cdiv id=\"들어가며\" class=\"anchor\"\u003e\u003c/div\u003e\n    \n    \u003cspan\n        class=\"absolute top-0 w-6 transition-opacity opacity-0 -start-6 not-prose group-hover:opacity-100 select-none\"\u003e\n        \u003ca class=\"text-primary-300 dark:text-neutral-700 !no-underline\" href=\"#%eb%93%a4%ec%96%b4%ea%b0%80%eb%a9%b0\" aria-label=\"Anchor\"\u003e#\u003c/a\u003e\n    \u003c/span\u003e\n    \n\u003c/h3\u003e\n\u003cp\u003e\u003ccode\u003eNext.js 15\u003c/code\u003e와 \u003ccode\u003eReact 19\u003c/code\u003e 환경에서 상태를 관리하는 방식은 서버 컴포넌트의 등장으로 기존과는 완전히 다른 접근이 필요한데요.\u003c/p\u003e","title":"Next.js 15 상태 관리, 글로벌 상태 없이 우아하게 해결하는 법","type":"guides"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/guides/go-concurrency-complete-guide/06-go-concurrency-waitgroup/","section":"Guides 리스트","summary":"\u003cp\u003eGo에서 채널은 만능 동시성 도구입니다.\u003c/p\u003e\n\u003cp\u003e지금까지 우리는 채널을 이용해 \u003cstrong\u003e데이터 전달\u003c/strong\u003e, \u003cstrong\u003e동기화\u003c/strong\u003e(Done 채널), \u003cstrong\u003e취소\u003c/strong\u003e(Cancel 채널) 등을 다뤘습니다.\u003c/p\u003e\n\u003cp\u003e데이터 전달은 채널의 본업이니 아주 잘 해내죠.\u003c/p\u003e","title":"Go Concurrency 마스터하기: 웨이트 그룹(WaitGroup), 동기화의 핵심 도구","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/06-nextjs-app-router-rest-api-design/","section":"Guides 리스트","summary":"\u003cp\u003e백엔드 API를 어떻게 설계하는지가 Next.js 프로젝트의 성패를 좌우하기도 하는데요.\u003c/p\u003e\n\u003cp\u003e결론부터 말씀드리면, Next.js와 가장 잘 맞는 백엔드 API는 바로 \u0026lsquo;세분화된(fine-grained)\u0026rsquo; 단위로 설계된 API입니다.\u003c/p\u003e","title":"Next.js 앱 라우터와 최고의 궁합 REST API 설계법","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/nextjs-15-react-19-best-practices-guide/06-caching-strategy/","section":"Guides 리스트","summary":"\u003ch3 class=\"relative group\"\u003e들어가며\n    \u003cdiv id=\"들어가며\" class=\"anchor\"\u003e\u003c/div\u003e\n    \n    \u003cspan\n        class=\"absolute top-0 w-6 transition-opacity opacity-0 -start-6 not-prose group-hover:opacity-100 select-none\"\u003e\n        \u003ca class=\"text-primary-300 dark:text-neutral-700 !no-underline\" href=\"#%eb%93%a4%ec%96%b4%ea%b0%80%eb%a9%b0\" aria-label=\"Anchor\"\u003e#\u003c/a\u003e\n    \u003c/span\u003e\n    \n\u003c/h3\u003e\n\u003cp\u003e\u003ccode\u003eNext.js 15\u003c/code\u003e에서는 캐시 전략에 아주 큰 방향 전환이 있었는데요.\u003c/p\u003e","title":"Next.js 15 캐시 전략, 제대로 이해하고 성능 끌어올리기","type":"guides"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/guides/go-concurrency-complete-guide/07-go-concurrency-mutex/","section":"Guides 리스트","summary":"\u003cp\u003e여러 고루틴이 동시에 같은 데이터를 건드리면 어떻게 될까요?\u003c/p\u003e\n\u003cp\u003e슬프게도, 아무 일도 일어나지 않거나 끔찍한 일이 벌어집니다.\u003c/p\u003e\n\u003cp\u003e이번 장에서는 동시성 프로그래밍의 가장 큰 적인 \u003cstrong\u003e데이터 경쟁\u003c/strong\u003e(Data Race)과 이를 해결하는 \u003cstrong\u003e뮤텍스\u003c/strong\u003e(Mutex)에 대해 알아보겠습니다.\u003c/p\u003e","title":"Go Concurrency 마스터하기: 뮤텍스(Mutex), 데이터 경쟁을 막는 방패","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/07-nextjs-dynamic-data-fetching-server-functions/","section":"Guides 리스트","summary":"\u003cp\u003e사용자 행동에 따라 데이터를 새로 가져오고 화면을 다시 그려야 할 때가 있는데요.\u003c/p\u003e\n\u003cp\u003e이럴 때는 \u0026lsquo;서버 펑션(Server Functions)\u0026lsquo;과 \u003ccode\u003euseActionState()\u003c/code\u003e 훅을 사용하는 것이 정답입니다.\u003c/p\u003e","title":"Next.js 동적 데이터 fetching Server Functions로 끝내기","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/nextjs-15-react-19-best-practices-guide/07-error-handling/","section":"Guides 리스트","summary":"\u003ch3 class=\"relative group\"\u003e들어가며\n    \u003cdiv id=\"들어가며\" class=\"anchor\"\u003e\u003c/div\u003e\n    \n    \u003cspan\n        class=\"absolute top-0 w-6 transition-opacity opacity-0 -start-6 not-prose group-hover:opacity-100 select-none\"\u003e\n        \u003ca class=\"text-primary-300 dark:text-neutral-700 !no-underline\" href=\"#%eb%93%a4%ec%96%b4%ea%b0%80%eb%a9%b0\" aria-label=\"Anchor\"\u003e#\u003c/a\u003e\n    \u003c/span\u003e\n    \n\u003c/h3\u003e\n\u003cp\u003e\u003ccode\u003eNext.js 15\u003c/code\u003e와 \u003ccode\u003eReact 19\u003c/code\u003e에서 에러 핸들링은 서버 컴포넌트와 클라이언트 컴포넌트에서 서로 다른 접근 방식이 필요한데요.\u003c/p\u003e","title":"Next.js 15 에러 핸들링 완벽 가이드, Result 타입부터 Error Boundary까지","type":"guides"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/guides/go-concurrency-complete-guide/08-go-concurrency-race-condition/","section":"Guides 리스트","summary":"\u003cp\u003e지난 장에서 배운 뮤텍스(Mutex)로 \u003cstrong\u003e데이터 경쟁\u003c/strong\u003e(Data Race)은 막을 수 있습니다.\u003c/p\u003e\n\u003cp\u003e하지만 \u003cstrong\u003e경쟁 상태\u003c/strong\u003e(Race Condition)는 차원이 다른 문제입니다.\u003c/p\u003e\n\u003cp\u003e데이터 경쟁이 \u0026ldquo;메모리 접근 오류\u0026quot;라면, 경쟁 상태는 \u0026ldquo;논리적 순서 오류\u0026quot;입니다.\u003c/p\u003e","title":"Go Concurrency 마스터하기: 경쟁 상태(Race Condition), 뮤텍스 너머의 세계","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/08-nextjs-use-client-use-server-bundle-boundary/","section":"Guides 리스트","summary":"\u003cp\u003e\u0026lsquo;리액트 서버 컴포넌트(React Server Components, RSC)\u0026lsquo;의 공식 RFC 문서에는 이런 구절이 있는데요.\u003c/p\u003e\n\u003cp\u003e\u0026ldquo;근본적인 과제는, 리액트 앱이 클라이언트 중심이라 서버를 충분히 활용하지 못했다는 점이다.\u0026rdquo;\u003c/p\u003e","title":"Next.js 'use client' 'use server' 실행 환경이 아니라고?","type":"guides"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/guides/go-concurrency-complete-guide/09-go-concurrency-semaphore/","section":"Guides 리스트","summary":"\u003cp\u003e멀티 코어의 힘을 풀가동하는 것도 좋지만, 때로는 시스템의 일부분에서 동시성을 \u003cstrong\u003e제한\u003c/strong\u003e해야 할 때가 있습니다.\u003c/p\u003e\n\u003cp\u003e너무 많은 요청으로 외부 시스템을 마비시키지 않으려면 말이죠.\u003c/p\u003e","title":"Go Concurrency 마스터하기: 세마포어(Semaphore), 동시성 제한의 기술","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/09-nextjs-client-component-use-cases/","section":"Guides 리스트","summary":"\u003cp\u003e\u0026lsquo;데이터 페칭\u0026rsquo;에서는 서버 컴포넌트 중심으로 설계 패턴을 알아봤는데요.\u003c/p\u003e\n\u003cp\u003eNext.js의 전체적인 컴포넌트 설계는 서버 컴포넌트를 중심으로, 필요한 곳에 클라이언트 컴포넌트를 적절히 조합하는 방식으로 이루어집니다.\u003c/p\u003e","title":"Next.js 'use client' 꼭 써야만 하는 3가지 결정적 순간","type":"guides"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/guides/go-concurrency-complete-guide/10-go-concurrency-signaling/","section":"Guides 리스트","summary":"\u003cp\u003eGo에서 고루틴끼리 대화하는 주된 수단은 \u003cstrong\u003e채널\u003c/strong\u003e(Channel)입니다.\u003c/p\u003e\n\u003cp\u003e하지만 채널이 유일한 방법은 아닙니다.\u003c/p\u003e\n\u003cp\u003e때로는 \u003cstrong\u003e조건 변수\u003c/strong\u003e(Condition Variable)나 \u003cstrong\u003e원자적 초기화\u003c/strong\u003e 같은 도구가 더 효율적일 때가 있습니다.\u003c/p\u003e","title":"Go Concurrency 마스터하기: 시그널링(Signaling), 채널보다 빠른 소통","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/10-nextjs-composition-pattern-to-protect-server-components/","section":"Guides 리스트","summary":"\u003cp\u003e결론부터 말씀드리면, \u0026lsquo;컴포지션 패턴\u0026rsquo;을 제대로 활용해야 하는데요.\u003c/p\u003e\n\u003cp\u003e이것이야말로 서버 컴포넌트 중심의 설계를 유지하면서도 클라이언트 컴포넌트를 꼭 필요한 곳에만 똑똑하게 심을 수 있는 핵심 기술입니다.\u003c/p\u003e","title":"서버 컴포넌트를 지키는 마지막 방어선 컴포지션 패턴","type":"guides"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/guides/go-concurrency-complete-guide/11-go-concurrency-atomics/","section":"Guides 리스트","summary":"\u003cp\u003e멀티 코어의 성능을 극한으로 끌어올리려면, 가끔은 \u003cstrong\u003e뮤텍스\u003c/strong\u003e(Mutex)조차 무겁게 느껴질 때가 있습니다.\u003c/p\u003e\n\u003cp\u003e이럴 때 사용하는 비밀 병기가 바로 \u003cstrong\u003e원자적 연산\u003c/strong\u003e(Atomic Operations)입니다.\u003c/p\u003e","title":"Go Concurrency 마스터하기: 원자적 연산(Atomics), 락(Lock) 없이 안전하게","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/11-nextjs-design-thinking-ui-as-a-tree/","section":"Guides 리스트","summary":"\u003cp\u003e결론부터 말씀드리면, 리액트 설계의 가장 기본 철학은 UI를 컴포넌트 \u0026lsquo;트리\u0026rsquo;로 설계하는 것인데요.\u003c/p\u003e\n\u003cp\u003e페이지나 레이아웃을 만들 때, 이 \u0026lsquo;UI를 트리로 분해하는\u0026rsquo; 작업부터 시작해야 합니다.\u003c/p\u003e","title":"Next.js 컴포넌트 설계 처음부터 제대로 하는 법 UI를 트리로 보기","type":"guides"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/guides/go-concurrency-complete-guide/12-go-concurrency-testing/","section":"Guides 리스트","summary":"\u003cp\u003e잘 설계된 동시성 프로그램은 채널과 웨이트 그룹 같은 표준 도구만으로도 테스트가 가능합니다.\u003c/p\u003e\n\u003cp\u003e하지만 현실은 늘 복잡하죠.\u003c/p\u003e\n\u003cp\u003e고루틴이 언제 끝날지 몰라 \u003ccode\u003etime.Sleep\u003c/code\u003e을 넣으며 기도해 본 적이 있나요?\u003c/p\u003e","title":"Go Concurrency 마스터하기: 동시성 코드 테스트, synctest로 시간 여행하기","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/12-nextjs-container-presentational-pattern-for-rsc/","section":"Guides 리스트","summary":"\u003cp\u003e결론부터 말씀드리면, 데이터 조회는 \u0026lsquo;컨테이너 컴포넌트(Container Components)\u0026lsquo;에, 데이터 표시는 \u0026lsquo;프레젠테이셔널 컴포넌트(Presentational Components)\u0026lsquo;에 분리하는 것이 좋은데요.\u003c/p\u003e\n\u003cp\u003e이렇게 책임을 나누면 테스트 용이성을 극적으로 향상시킬 수 있는 아주 강력한 전략입니다.\u003c/p\u003e","title":"Next.js 테스트 Container Presentational 패턴으로 정복하기","type":"guides"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/guides/go-concurrency-complete-guide/13-go-concurrency-internals/","section":"Guides 리스트","summary":"\u003cp\u003e우리는 지금까지 \u0026ldquo;고루틴은 가볍다\u0026rdquo;, \u0026ldquo;런타임이 알아서 관리해 준다\u0026quot;라고만 알고 있었습니다.\u003c/p\u003e\n\u003cp\u003e하지만 어떻게 그게 가능한 걸까요?\u003c/p\u003e\n\u003cp\u003e이번 마지막 장에서는 Go 동시성의 엔진룸을 열어보고, 성능을 최적화하는 도구들을 살펴보겠습니다.\u003c/p\u003e","title":"Go Concurrency 마스터하기: 동시성의 내부, 스케줄러부터 프로파일링까지","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/13-nextjs-caching-deep-dive-static-rendering-and-full-route-cache/","section":"Guides 리스트","summary":"\u003cp\u003eNext.js에는 총 4개의 캐시 레이어가 존재하는데요.\u003c/p\u003e\n\u003cp\u003e이 캐시들은 기본적으로 아주 적극적으로 활용되도록 설계되어 있습니다.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003e리퀘스트 메모이제이션 (Request Memoization)\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cblockquote\u003e\n\u003cp\u003e서버에서 요청 단위로 API 응답 등을 재사용하는 캐시입니다.\u003c/p\u003e","title":"Next.js 캐싱 정복 1편 - Full Route Cache와 정적 렌더링","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/14-nextjs-caching-dynamic-rendering-data-cache/","section":"Guides 리스트","summary":"\u003cp\u003e동적 렌더링 페이지의 성능은 \u0026lsquo;데이터 캐시(Data Cache)\u0026lsquo;를 얼마나 잘 활용하는지에 달려있는데요.\u003c/p\u003e\n\u003cp\u003e이것이 바로 API 서버 부하를 줄이고 렌더링 속도를 획기적으로 높이는 핵심 전략입니다.\u003c/p\u003e","title":"Next.js 캐싱 정복 2편 - 동적 렌더링 성능 데이터 캐시로 잡기","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/15-nextjs-caching-router-cache-deep-dive/","section":"Guides 리스트","summary":"\u003cp\u003e\u0026lsquo;라우터 캐시(Router Cache)\u0026lsquo;는 페이지 이동 속도를 높여주는 클라이언트 사이드 캐시인데요.\u003c/p\u003e\n\u003cp\u003e우리 애플리케이션의 특성에 맞춰 유효 기간인 \u003ccode\u003estaleTimes\u003c/code\u003e를 적절히 설정하고, 필요할 때 캐시를 갱신(revalidate)해 주는 것이 핵심입니다.\u003c/p\u003e","title":"Next.js 캐싱 정복 3편 - 클라이언트 캐시 Router Cache 완벽 이해","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/16-nextjs-server-actions-for-data-mutation/","section":"Guides 리스트","summary":"\u003cp\u003e결론부터 말씀드리면, 앱 라우터 시대의 데이터 \u0026lsquo;수정\u0026rsquo; 작업은 \u0026lsquo;서버 액션(Server Actions)\u0026lsquo;으로 구현하는 것이 기본이자 정답입니다.\u003c/p\u003e\n\n\u003ch3 class=\"relative group\"\u003e과거 방식의 한계\n    \u003cdiv id=\"과거-방식의-한계\" class=\"anchor\"\u003e\u003c/div\u003e\n    \n    \u003cspan\n        class=\"absolute top-0 w-6 transition-opacity opacity-0 -start-6 not-prose group-hover:opacity-100 select-none\"\u003e\n        \u003ca class=\"text-primary-300 dark:text-neutral-700 !no-underline\" href=\"#%ea%b3%bc%ea%b1%b0-%eb%b0%a9%ec%8b%9d%ec%9d%98-%ed%95%9c%ea%b3%84\" aria-label=\"Anchor\"\u003e#\u003c/a\u003e\n    \u003c/span\u003e\n    \n\u003c/h3\u003e\n\u003cp\u003e과거 페이지 라우터 시절에는 데이터를 \u0026lsquo;가져오는\u0026rsquo; 방법은 공식적으로 제공됐지만, 데이터를 \u0026lsquo;수정하는\u0026rsquo; 명확한 방법은 없었거든요.\u003c/p\u003e","title":"Next.js 데이터 수정 Server Actions 하나로 끝내는 법","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/17-nextjs-server-component-purity-and-memoization/","section":"Guides 리스트","summary":"\u003cp\u003e기존 페이지 라우터는 SSR, SSG, ISR이라는 3가지 렌더링 모델을 지원했는데요.\u003c/p\u003e\n\u003cp\u003e앱 라우터 역시 이 방식들을 계속 지원하지만, 여기에 \u0026lsquo;스트리밍 SSR(Streaming SSR)\u0026lsquo;까지 지원한다는 점에서 아주 큰 차이를 보입니다.\u003c/p\u003e","title":"Next.js 서버 컴포넌트의 숨겨진 원칙 순수성과 메모이제이션","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/18-nextjs-suspense-and-streaming-ssr-for-performance/","section":"Guides 리스트","summary":"\u003cp\u003e결론부터 말씀드리면, 동적 렌더링 환경에서 특히 무거운 컴포넌트는 \u003ccode\u003e\u0026lt;Suspense\u0026gt;\u003c/code\u003e로 감싸서 렌더링을 지연시키고, \u0026lsquo;스트리밍 SSR\u0026rsquo;을 활용하는 것이 좋은데요.\u003c/p\u003e\n\u003cp\u003e이것이 바로 사용자 경험을 극대화하는 핵심 전략입니다.\u003c/p\u003e","title":"Next.js Suspense와 스트리밍으로 사용자 경험 극대화하기","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/19-nextjs-accessing-request-response-data/","section":"Guides 리스트","summary":"\u003cp\u003eNext.js는 기존 웹 프레임워크와는 다른 독특한 특징들이 있는데요.\u003c/p\u003e\n\u003cp\u003e예를 들어 \u003ccode\u003ereq\u003c/code\u003e, \u003ccode\u003eres\u003c/code\u003e 같은 요청/응답 객체에 직접 접근할 수 없거나, 요청 중간에 인증/인가 체크를 끼워 넣는 미들웨어 레이어가 조금 다르게 동작합니다.\u003c/p\u003e","title":"Next.js에서 req res 없이 요청과 응답 다루는 법","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/20-nextjs-authentication-and-authorization-patterns/","section":"Guides 리스트","summary":"\u003cp\u003eNext.js에서 인증(Authentication) 상태를 유지하는 방법은 크게 두 가지인데요.\u003c/p\u003e\n\u003cp\u003e필요한 정보를 쿠키에 직접 저장하거나, 세션 ID만 쿠키에 담고 실제 데이터는 Redis 같은 곳에 저장하는 방식입니다.\u003c/p\u003e","title":"Next.js 인증과 인가 완벽 가이드 이 방법만 아세요","type":"guides"},{"date":"Oct 26, 2025","externalUrl":null,"permalink":"/guides/the-nextjs-way-of-thinking/21-nextjs-error-handling-guide-server-components-and-functions/","section":"Guides 리스트","summary":"\u003cp\u003eNext.js의 에러는 크게 \u0026lsquo;서버 컴포넌트\u0026rsquo;와 \u0026lsquo;서버 펑션\u0026rsquo; 두 곳에서 발생하는데요.\u003c/p\u003e\n\u003cp\u003e서버 컴포넌트에서 에러가 나면 \u003ccode\u003eerror.tsx\u003c/code\u003e나 \u003ccode\u003enot-found.tsx\u003c/code\u003e 파일로 에러 전용 UI를 보여주고, 서버 펑션에서 발생하는 에러는 기본적으로 \u0026lsquo;반환 값\u0026rsquo;으로 표현하는 것이 좋습니다.\u003c/p\u003e","title":"Next.js 에러 핸들링 완벽 가이드 서버 컴포넌트와 서버 펑션","type":"guides"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/tags/concurrency/","section":"Tags","summary":"","title":"Concurrency","type":"tags"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/tags/go/","section":"Tags","summary":"","title":"Go","type":"tags"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/series/go-concurrency-%EC%99%84%EB%B2%BD-%EA%B0%80%EC%9D%B4%EB%93%9C/","section":"Series","summary":"","title":"Go Concurrency 완벽 가이드","type":"series"},{"date":"Dec 11, 2025","externalUrl":null,"permalink":"/tags/golang/","section":"Tags","summary":"","title":"Golang","type":"tags"},{"date":"Dec 11, 2025","e